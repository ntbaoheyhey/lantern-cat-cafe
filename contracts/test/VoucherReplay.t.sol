pragma solidity 0.8.24;

import {Test} from "forge-std/Test.sol";
import {RelicNFT} from "../src/RelicNFT.sol";

/// Offline EIP-712 replay regression tests; keys are generated by Foundry only.
contract VoucherReplayTest is Test {
    RelicNFT internal relic;
    address internal owner = makeAddr("replay-owner");
    address internal alice = makeAddr("replay-alice");
    address internal bob = makeAddr("replay-bob");
    uint256 internal signerKey;

    function setUp() public {
        vm.chainId(43113);
        vm.warp(1_800_000_000);
        (address signer, uint256 key) = makeAddrAndKey("replay-signer");
        signerKey = key;
        relic = new RelicNFT(owner, signer, "ipfs://relic/{id}");
    }

    function voucher() internal view returns (RelicNFT.Voucher memory) {
        return RelicNFT.Voucher({player: alice, relicId: 7, rarity: 3, nonce: 42, expiry: block.timestamp + 1 hours});
    }

    function sign(RelicNFT.Voucher memory v, uint256 key) internal view returns (bytes memory) {
        (uint8 sv, bytes32 r, bytes32 s) = vm.sign(key, relic.hashVoucher(v));
        return abi.encodePacked(r, s, sv);
    }

    function test_validVoucherMintsOnce() public {
        RelicNFT.Voucher memory v = voucher();
        bytes memory signature = sign(v, signerKey);
        vm.prank(alice);
        relic.mint(v, signature);
        assertEq(relic.balanceOf(alice, v.relicId), 1);
        assertTrue(relic.usedNonces(v.nonce));
    }

    function test_identicalVoucherReplayReverts() public {
        RelicNFT.Voucher memory v = voucher();
        bytes memory signature = sign(v, signerKey);
        vm.startPrank(alice);
        relic.mint(v, signature);
        vm.expectRevert(RelicNFT.NonceAlreadyUsed.selector);
        relic.mint(v, signature);
        vm.stopPrank();
        assertEq(relic.balanceOf(alice, v.relicId), 1);
    }

    function test_sameNonceWithAnotherSignedRelicIdReverts() public {
        RelicNFT.Voucher memory v = voucher();
        bytes memory signature = sign(v, signerKey);
        vm.prank(alice);
        relic.mint(v, signature);
        v.relicId = 8;
        signature = sign(v, signerKey); // Valid signature, so the nonce guard must reject it.
        vm.prank(alice);
        vm.expectRevert(RelicNFT.NonceAlreadyUsed.selector);
        relic.mint(v, signature);
        assertEq(relic.balanceOf(alice, 8), 0);
    }

    function test_expiredVoucherReverts() public {
        RelicNFT.Voucher memory v = voucher();
        bytes memory signature = sign(v, signerKey);
        vm.warp(v.expiry + 1);
        vm.prank(alice);
        vm.expectRevert(RelicNFT.VoucherExpired.selector);
        relic.mint(v, signature);
        assertFalse(relic.usedNonces(v.nonce));
    }

    function test_nonSignerVoucherReverts() public {
        RelicNFT.Voucher memory v = voucher();
        (, uint256 outsider) = makeAddrAndKey("replay-outsider");
        bytes memory signature = sign(v, outsider);
        vm.prank(alice);
        vm.expectRevert(RelicNFT.InvalidSignature.selector);
        relic.mint(v, signature);
        assertFalse(relic.usedNonces(v.nonce));
    }

    function test_playerASentByPlayerBReverts() public {
        RelicNFT.Voucher memory v = voucher();
        bytes memory signature = sign(v, signerKey);
        vm.prank(bob);
        vm.expectRevert(RelicNFT.NotVoucherPlayer.selector);
        relic.mint(v, signature);
        assertFalse(relic.usedNonces(v.nonce));
    }

    function test_ownerCancelledNonceReverts() public {
        RelicNFT.Voucher memory v = voucher();
        bytes memory signature = sign(v, signerKey);
        vm.prank(owner);
        relic.cancelNonce(v.nonce);
        vm.prank(alice);
        vm.expectRevert(RelicNFT.NonceAlreadyUsed.selector);
        relic.mint(v, signature);
        assertTrue(relic.usedNonces(v.nonce));
        assertEq(relic.balanceOf(alice, v.relicId), 0);
    }
}
