# Supabase project URL (client)
VITE_SUPABASE_URL=
# Supabase anon/publishable key (client, safe to expose)
VITE_SUPABASE_ANON_KEY=
# Avalanche Fuji RPC endpoint (client)
VITE_FUJI_RPC_URL=https://api.avax-test.network/ext/bc/C/rpc
# Supabase service role key (server only, never ship to client)
SUPABASE_SERVICE_ROLE_KEY=
# Private key of the EIP-712 voucher signer (server only)
VOUCHER_SIGNER_PRIVATE_KEY=
# Private key used to deploy contracts to Fuji (local only)
DEPLOYER_PRIVATE_KEY=
# Public address of the voucher signer key; set as RelicNFT.signer at deploy (local only)
VOUCHER_SIGNER_ADDRESS=
# ERC-1155 metadata URI with {id}, set at deploy (local only)
RELIC_BASE_URI=
# Optional legacy verifier key. tools/v5int/verify-fuji.mjs uses Routescan without a key.
SNOWTRACE_API_KEY=
# Supabase project JWT secret, HS256 key used by auth-verify to sign sessions (server only)
SUPABASE_JWT_SECRET=
# EIP-4361 domain the SIWE message must name, e.g. localhost:5173 (server)
SIWE_DOMAIN=
# Allowed CORS origin(s) for the auth Edge Functions, comma-separated, e.g. http://localhost:5173 (server).
# Required: when unset, no Access-Control-Allow-Origin header is sent and browsers are blocked.
SIWE_ALLOWED_ORIGIN=
# Optional HMAC key for idle-claim drop seeds (server). Falls back to the JWT secret when unset.
GAME_SEED_SECRET=

# CHAIN build flags: off unless explicitly enabled; demo enables all four.
VITE_CHAIN_DEMO=0
VITE_GUEST_WALLET=0
VITE_CHAIN_LOOP=0
VITE_ITEM_TRADING=0
VITE_YARN_TOKEN=0
# Optional finite cosmetic pilot; intentionally NOT enabled by VITE_CHAIN_DEMO.
VITE_YARN_COSMETICS=0
VITE_CHAIN_MODE=fuji
VITE_YARN_ADDRESS=
VITE_MARKET_V2_ADDRESS=
VITE_SEASON_REWARDS_ADDRESS=
# Server only: disabled until the user deploys the migration + function.
GUEST_DRIP_ENABLED=0
# Optional dedicated sponsor. Falls back to the existing VOUCHER_SIGNER_PRIVATE_KEY.
SPONSOR_PRIVATE_KEY=
# User-run bot only; never VITE_.
BOT_PRIVATE_KEY=

# Server: enable the capped testnet-only judge allocation after applying its migration.
CHAIN_JUDGE_ENABLED=0
# V2 server flags and public deployment addresses (user deploys).
CHAIN_ITEMS_ENABLED=0
# Optional5% self-seal price experiment; unset/0 preserves10%. Existing intents retain their price.
CHAIN_SEAL_PRICE_TRIAL=0
CHAIN_YARN_ENABLED=0
# Requires a reviewed, funded lifetime budget row; never seeds public limits.
CHAIN_TESTER_BUDGET_ENABLED=0
CHAIN_COSMETICS_ENABLED=0
# Both switches plus an explicit policy row are required; no browser-save import.
CHAIN_CAMPAIGN_ENABLED=0
VITE_CHAIN_CAMPAIGN=0
YARN_TOKEN_ADDRESS=
MARKET_V2_ADDRESS=
SEASON_REWARDS_ADDRESS=
YARN_DISTRIBUTOR_ADDRESS=
YARN_TREASURY_ADDRESS=
MARKET_FEE_BPS=500
# Operator-only secret environment, never VITE_ and never commit values.
DISTRIBUTOR_PRIVATE_KEY=
SMOKE_SELLER_PRIVATE_KEY=
SMOKE_BUYER_PRIVATE_KEY=
# Operator smoke API origin, matching SIWE_DOMAIN/SIWE_ALLOWED_ORIGIN.
SUPABASE_URL=
WEB_ORIGIN=

# V2 deployment only; kept distinct from the legacy NFT deployment script.
CHAIN_DEPLOYER_PRIVATE_KEY=
CHAIN_VOUCHER_SIGNER_ADDRESS=

# Optional finite forge; user-deployed new vault, existing NFT/YARN unchanged.
VITE_RELIC_FORGE=0
VITE_RELIC_FORGE_ADDRESS=

# User-run optional forge deployment only; never VITE_ or a committed value.
CHAIN_FORGE_DEPLOYER_PRIVATE_KEY=

# Optional earned claims: also requires a funded budget and a one-season program.
CHAIN_CAMPAIGN_REWARDS_ENABLED=0
VITE_CHAIN_CAMPAIGN_REWARDS=0

# V9 recording: copy ONLY the public VITE_* values into apps/web/.env.local.
# Run: node tools/v5int/run-chain-mode.mjs
# The command sets VITE_CHAIN_DEMO=1 and VITE_CHAIN_MODE=fuji for build + preview on 6301.
# Owner configures server secrets separately; never put them in apps/web/.env.local.
# For the recording: GUEST_DRIP_ENABLED=1, CHAIN_JUDGE_ENABLED=1,
# SIWE_DOMAIN=127.0.0.1:6301 and SIWE_ALLOWED_ORIGIN=http://127.0.0.1:6301.
# Hosted Supabase fallback when the reserved SUPABASE_JWT_SECRET cannot be set:
AUTH_JWT_SECRET=
# Server public RPC (uses the public Fuji default if unset).
FUJI_RPC_URL=https://api.avax-test.network/ext/bc/C/rpc
