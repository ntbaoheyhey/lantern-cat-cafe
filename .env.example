# Supabase project URL (client)
VITE_SUPABASE_URL=
# Supabase anon/publishable key (client, safe to expose)
VITE_SUPABASE_ANON_KEY=
# Avalanche Fuji RPC endpoint (client)
VITE_FUJI_RPC_URL=https://api.avax-test.network/ext/bc/C/rpc
# Supabase service role key (server only, never ship to client)
SUPABASE_SERVICE_ROLE_KEY=
# Private key of the EIP-712 voucher signer (server only)
VOUCHER_SIGNER_PRIVATE_KEY=
# Private key used to deploy contracts to Fuji (local only)
DEPLOYER_PRIVATE_KEY=
# Snowtrace API key for contract verification
SNOWTRACE_API_KEY=
# Supabase project JWT secret, HS256 key used by auth-verify to sign sessions (server only)
SUPABASE_JWT_SECRET=
# EIP-4361 domain the SIWE message must name, e.g. localhost:5173 (server)
SIWE_DOMAIN=
# Allowed CORS origin(s) for the auth Edge Functions, comma-separated, e.g. http://localhost:5173 (server).
# Required: when unset, no Access-Control-Allow-Origin header is sent and browsers are blocked.
SIWE_ALLOWED_ORIGIN=
# Optional HMAC key for idle-claim drop seeds (server). Falls back to the JWT secret when unset.
GAME_SEED_SECRET=
