{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "types": ["node"],
    // Lets tests import the Deno Edge Function code (which uses .ts specifiers and the same
    // @taskbar-hero/game-rules alias as the functions' deno.json import maps).
