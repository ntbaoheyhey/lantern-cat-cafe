+  chapter: 2,
+  round: 5,
+  kills: 2,
+  killsPerRound: 10,
+  gated: true,
+  neededPower: 1500,
+  keys: 1,
+});
+
+/** Player holding maximum key stack (5 keys) */
+export const hudMaxKeysState: ServerStateV2 = sampleServerStateV2({
+  level: 15,
+  chapter: 3,
+  round: 8,
+  kills: 7,
