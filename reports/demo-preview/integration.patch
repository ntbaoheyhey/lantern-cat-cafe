+  level: 5,
+  chapter: 1,
+  round: 3,
+  kills: 4,
+  killsPerRound: 10,
+  gated: false,
+  neededPower: 0,
+  keys: 1,
+});
+
+/** Progression-gated player needing more power to advance */
