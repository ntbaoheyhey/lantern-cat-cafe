+  gated: false,
+  neededPower: 0,
+  keys: 5,
+});
+
+/** Player with zero fish, yarn, and keys */
+export const hudZeroCurrenciesState: ServerStateV2 = {
+  ...sampleServerStateV2({
+    level: 1,
+    chapter: 1,
