diff --git a/apps/web/src/layout/forge/ForgePanel.css b/apps/web/src/layout/forge/ForgePanel.css
index 57c25c5..ac3d628 100644
--- a/apps/web/src/layout/forge/ForgePanel.css
+++ b/apps/web/src/layout/forge/ForgePanel.css
@@ -1,5 +1,115 @@
 /* Cat Café Quest v2 - ForgePanel styles (Craft, Salvage, Relic) */
 
+/* 3-column desktop layout (AGR3 Redesign) */
+.forge-cols {
+  display: grid;
+  grid-template-columns: 300px 1fr 320px;
+  gap: var(--sp-3, 14px);
+  height: 100%;
+  min-height: 0;
+  align-items: stretch;
+  box-sizing: border-box;
+}
+
+
+.forge-col-left,
+.forge-col-centre,
+.forge-col-right {
+  min-width: 0;
+  min-height: 0;
+  box-sizing: border-box;
+}
+
+.forge-col-left {
+  display: flex;
+  flex-direction: column;
+  gap: 12px;
+  overflow-y: auto;
+}
+
+.forge-col-centre {
+  background: radial-gradient(circle at 50% 45%, #5a3560, var(--surface, #2a1f36) 70%) !important;
+  display: flex;
+  flex-direction: column;
+  align-items: center;
+  justify-content: center;
+  text-align: center;
+  padding: 20px;
+  position: relative;
+  overflow: hidden;
+  border: 2px solid var(--border, #5b4572);
+  box-shadow: var(--pixel-shadow, 3px 3px 0 #000);
+}
+
+.forge-col-right {
+  display: flex;
+  flex-direction: column;
+  gap: 14px;
+  overflow-y: auto;
+}
+
+.forge-preview-slot {
+  width: 120px;
+  height: 120px;
+  background: var(--bg, #1a1220);
+  border: 2px solid var(--border, #72578d);
+  box-shadow: var(--pixel-shadow, 3px 3px 0 #000);
+  display: grid;
+  place-items: center;
+  position: relative;
+  margin-bottom: 8px;
+}
+
+.forge-candidate-preview {
+  margin-top: 8px;
+  display: flex;
