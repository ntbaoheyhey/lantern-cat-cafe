   gap: var(--sp-1, 4px);
@@ -73,6 +184,7 @@
 
 /* Segmented Control (Craft / Salvage / Relic) */
 .forge-nav {
+  flex: none;
   display: flex;
   flex-direction: row;
   align-items: stretch;
@@ -496,7 +608,7 @@
   box-shadow: var(--pixel-shadow, 3px 3px 0 #000);
 }
 
-.forge-btn-cancel {
+.forge-panel .forge-btn.forge-btn-cancel {
   flex: 1 1 100px;
   background: var(--surface, #2a1f36);
   color: var(--text, #fff3e0);
@@ -854,8 +966,11 @@
 }
 
 @media (prefers-reduced-motion: reduce) {
+  .forge-flash,
   .forge-confirm-box {
-    animation: none;
+    animation: none !important;
+    transition: none !important;
+    filter: none !important;
   }
   .forge-tab-btn,
   .forge-btn,
@@ -865,3 +980,14 @@
     transform: none !important;
   }
 }
+
+.forge-preview-art { position:relative; display:grid; place-items:center; }
+.forge-preview-glyph { position:absolute; display:grid; place-items:center; }
+
+/* Preserve the compact panel's immediately reachable action while its choices scroll. */
+@media (max-width: 960px) {
+  .forge-cols { display: flex; flex-direction: column; height: auto; overflow: visible; }
+  .forge-col-left, .forge-col-centre, .forge-col-right { flex: none; overflow: visible; }
+  .forge-col-centre { order: -1; padding: var(--sp-3, 12px); }
+  .forge-col-centre .forge-action-area { order: -1; margin-top: 0 !important; margin-bottom: var(--sp-3, 12px); }
+}
