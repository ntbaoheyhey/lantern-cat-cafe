{
  "label": "M4 B closure",
  "root": "/tmp/cardrpg-v5full-m4/b-closure",
  "cwd": "/Users/bao/taskbar-hero-cardrpg-b2",
  "env": {},
  "groups": [
    {
      "name": "source",
      "lock": false,
      "jobs": [
        {
          "name": "typecheck",
          "args": [
            "pnpm",
            "typecheck"
          ],
          "env": {}
        },
        {
          "name": "lint",
          "args": [
            "pnpm",
            "lint"
          ],
          "env": {}
        },
        {
          "name": "unit",
          "args": [
            "pnpm",
            "test"
          ],
          "env": {}
        },
        {
          "name": "build",
          "args": [
            "pnpm",
            "build"
          ],
          "env": {}
        },
        {
          "name": "startup-prepare",
          "args": [
            "node",
            "tools/cardrpg-look/flag-off-check.mjs",
            "--prepare"
          ],
          "env": {
            "BIG_FLAG_OFF_DIST": "/tmp/cardrpg-v5full-m4/b-closure/startup/dist",
            "BIG_FLAG_OFF_OUT": "/tmp/cardrpg-v5full-m4/b-closure/startup"
          }
        }
      ]
    },
    {
      "name": "E2E and OFF startup",
      "lock": true,
      "jobs": [
        {
          "name": "e2e",
          "args": [
            "pnpm",
            "--filter",
            "@taskbar-hero/web",
            "test:e2e"
          ],
          "env": {
            "E2E_PORT_CLASSIC": "5920",
            "E2E_PORT_V2": "5921",
            "E2E_PORT_SERVER": "5922",
            "E2E_PORT_API": "5923"
          }
        },
        {
          "name": "startup",
          "args": [
            "node",
            "tools/cardrpg-look/flag-off-check.mjs"
          ],
          "env": {
            "BIG_FLAG_OFF_DIST": "/tmp/cardrpg-v5full-m4/b-closure/startup/dist",
            "BIG_FLAG_OFF_OUT": "/tmp/cardrpg-v5full-m4/b-closure/startup"
          }
        }
      ]
    }
  ]
}