diff --git a/apps/web/src/motion.css b/apps/web/src/motion.css
index f3bf5cf..c1847be 100644
--- a/apps/web/src/motion.css
+++ b/apps/web/src/motion.css
@@ -156,3 +156,49 @@
     transform: none !important;
   }
 }
+
+
+/* U4: short compositor transitions. Static dimensions never depend on progress. */
+.motion-number { display: inline-block; max-inline-size: 100%; text-align: left; font-variant-numeric: tabular-nums; overflow-wrap: anywhere; }
+.motion-cue { outline: 2px solid transparent; outline-offset: 3px; }
+@keyframes motion-panel-enter { from { opacity: .94; } to { opacity: 1; } }
+@keyframes motion-loot-pop { from { transform: translateY(3px); } to { transform: translateY(0); } }
+@keyframes motion-forge-reveal { from { transform: scale(.985); } to { transform: scale(1); } }
+@media (prefers-reduced-motion: no-preference) {
+  .shell-panel-view { animation: motion-panel-enter 140ms ease-out; }
+  .loot-item-art { animation: motion-loot-pop 180ms ease-out; }
+  .forge-result-reveal.forge-flash { animation: motion-forge-reveal 180ms ease-out; }
+  :where(.pixel-btn, .pixel-btn--secondary, .forge-btn, .rail-item, .landing__guest-btn) { transition: transform 100ms ease-out, filter 100ms ease-out; }
+  :where(.pixel-btn, .pixel-btn--secondary, .forge-btn, .rail-item, .landing__guest-btn):hover:not(:disabled) { filter: brightness(1.06); }
+  :where(.pixel-btn, .pixel-btn--secondary, .forge-btn, .rail-item, .landing__guest-btn):active:not(:disabled) { transform: translateY(2px); }
+}
+@media (prefers-reduced-motion: reduce) {
+  .fx-pop, .tab-content, .shell-panel-view, .loot-item-art, .forge-result-reveal.forge-flash { animation: none !important; transform: none !important; }
+  .fx-float { animation: none !important; transform: none !important; opacity: 0; }
+  :where(.pixel-btn, .pixel-btn--secondary, .forge-btn, .rail-item, .landing__guest-btn) { transition: none !important; }
+  :where(.pixel-btn, .pixel-btn--secondary, .forge-btn, .rail-item, .landing__guest-btn):active:not(:disabled) { transform: none !important; }
+}
+
+@media (min-width: 961px) { .motion-number { inline-size: 7ch; } }
+
+/* Currency labels and neighbouring pills keep their positions as amounts grow. */
+.home-card--loot .home-loot-currencies { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); }
+.home-card--loot .home-loot-curr-pill { display: grid; grid-template-columns: 16px minmax(0, 1fr); grid-template-rows: 16px minmax(28px, auto); align-items: start; }
+.home-card--loot .home-loot-curr-name { grid-column: 2; grid-row: 1; }
+.home-card--loot .home-loot-curr-val { grid-column: 1 / 3; grid-row: 2; text-align: left; line-height: 14px; }
+
+/* Expanding a confirmation must keep the action at the same scroll position. */
+.forge-craft-scroll { overflow-anchor: none; }
+
+@media (min-width: 961px) { .hud-level-badge.motion-cue { min-inline-size: 6ch; } }
+
+/* Fish can reach the representable maximum; keep its two lines inside the HUD chip. */
+@media (min-width: 961px) { .hud-gold .motion-number { inline-size: 11ch; } }
+
+/* The live first-reward heading sits on a night card, including with no OS theme attribute. */
+:root .home-card--loot.v2-recent-loot .loot-summary-heading { color: var(--accent); }
+
+/* Leave room for Chapter 5 / Round 10 / 10 kills beside the fixed numeric columns. */
+@media (min-width: 1200px) and (max-width: 1399px) {
+  .shell-hud.v2-topbar .hud-bar__layout { column-gap: var(--sp-1, 4px); }
+}
