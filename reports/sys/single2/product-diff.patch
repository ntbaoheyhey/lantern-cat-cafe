diff --git a/apps/web/e2e/server/expired-session-feedback.spec.ts b/apps/web/e2e/server/expired-session-feedback.spec.ts
new file mode 100644
index 0000000..a0015bc
--- /dev/null
+++ b/apps/web/e2e/server/expired-session-feedback.spec.ts
@@ -0,0 +1,49 @@
+import { test, expect, control, install } from '../support/server-fixture';
+import { pinVisualFonts } from '../support/visual-fonts';
+import type { Session } from '../../src/wallet/session';
+import { mockV2Save } from '../../src/api/mockV2Fixtures';
+import { readFileSync, mkdirSync } from 'node:fs';
+import { resolve } from 'node:path';
+const key = readFileSync('src/api/MockGameApiV2.ts', 'utf8').match(/MOCK_V2_STORAGE_KEY = '([^']+)'/)![1]!;
+for (const savedGuest of [false, true]) {
+  test(`Expired server session explains guest recovery, saved guest ${savedGuest}`, async ({ page, context, request }) => {
+    const session = await control<Session>(request, 'session', { kind: 'stocked' });
+    await install(context, session);
+    await pinVisualFonts(page);
+    if (savedGuest) await page.addInitScript(({ key, save }) => localStorage.setItem(key, save), {
+      key, save: JSON.stringify(mockV2Save('midGame', { nowMs: Date.now(), classId: 'warrior' })),
+    });
+    await page.route('**/functions/v1/v2-state', route => route.fulfill({ status: 401,
+      contentType: 'application/json', headers: { 'access-control-allow-origin': '*' },
+      body: JSON.stringify({ error: 'unauthenticated' }),
+    }));
+    const errors: string[] = [];
+    page.on('pageerror', error => errors.push(error.message));
+    page.on('console', message => {
+      // Chromium reports the deliberately mocked 401 as a failed resource.
+      if (message.type() === 'error' && !(message.location().url.endsWith('/v2-state') && message.text().includes('401'))) errors.push(message.text());
+    });
+    await page.goto('/#home');
+    const notice = page.getByTestId('session-expired-notice');
+    await expect(notice).toBeVisible();
+    await expect(notice).toHaveAttribute('role', 'status');
+    await expect(notice).toContainText('Your session expired');
+    await expect(notice).toContainText('Sign in again');
+    expect(await page.evaluate(() => sessionStorage.getItem('taskbar-hero.session'))).toBeNull();
+    if (savedGuest) await expect(page.getByTestId('home-dashboard')).toBeVisible();
+    else {
+      await expect(page.getByTestId('class-picker')).toBeVisible();
+      await page.getByTestId('class-picker-choose-button').click();
+      await page.getByTestId('class-picker-confirm-button').click();
+      await expect(page.getByTestId('home-dashboard')).toBeVisible();
+      await expect(notice).toBeVisible();
+    }
+    expect(await page.evaluate(() => document.documentElement.scrollWidth > innerWidth || document.documentElement.scrollHeight > innerHeight)).toBe(false);
+    await expect(notice).toBeInViewport({ ratio: 1 });
+    if (process.env.CXR2_SCREENSHOTS) {
+      mkdirSync(process.env.CXR2_SCREENSHOTS, { recursive: true });
+      await page.screenshot({ path: resolve(process.env.CXR2_SCREENSHOTS, `expired-${savedGuest}-${page.viewportSize()!.width}.png`) });
+    }
+    expect(errors).toEqual([]);
+  });
+}
diff --git a/apps/web/e2e/support/art-ready.ts b/apps/web/e2e/support/art-ready.ts
new file mode 100644
index 0000000..963fef2
--- /dev/null
+++ b/apps/web/e2e/support/art-ready.ts
@@ -0,0 +1,44 @@
+import { expect, type Page } from '@playwright/test';
+
+/** Decode the actual visible paint, inspect its clipped pixels, then allow two paints. */
+export async function expectArtPaint(page: Page, selector = '[data-original-art], [data-art2]') {
+  await page.evaluate(() => document.fonts.ready);
+  const paints = await page.locator(selector).evaluateAll(async nodes => {
+    const result: { id: string; colors: number; opaque: number; width: number; height: number }[] = [];
+    for (const node of nodes) {
+      const box = node.getBoundingClientRect();
+      if (!box.width || !box.height || box.bottom <= 0 || box.top >= innerHeight) continue;
+      const style = getComputedStyle(node);
+      const isImage = node instanceof HTMLImageElement;
+      const url = isImage ? node.currentSrc || node.src : style.backgroundImage.match(/url\(["']?(.*?)["']?\)/)?.[1];
+      if (!url) throw new Error('Missing art source: ' + node.outerHTML.slice(0, 120));
+      const image = new Image(); image.src = url; await image.decode();
+      if (isImage) await node.decode();
+      const canvas = document.createElement('canvas');
+      canvas.width = Math.round(box.width); canvas.height = Math.round(box.height);
+      const context = canvas.getContext('2d'); if (!context) throw new Error('Canvas unavailable');
+      context.imageSmoothingEnabled = false;
+      if (isImage) context.drawImage(image, 0, 0, canvas.width, canvas.height);
+      else {
+        const [w, h] = style.backgroundSize.split(' ').map(Number.parseFloat);
+        const [x, y] = style.backgroundPosition.split(' ').map(Number.parseFloat);
+        if (![w, h, x, y].every(value => Number.isFinite(value))) throw new Error('Unresolved atlas geometry');
+        context.drawImage(image, x!, y!, w!, h!);
+      }
+      const pixels = context.getImageData(0, 0, canvas.width, canvas.height).data;
+      const colors = new Set<string>(); let opaque = 0;
+      for (let i = 0; i < pixels.length; i += 4) if (pixels[i + 3]) {
+        opaque++; colors.add(`${pixels[i]},${pixels[i + 1]},${pixels[i + 2]}`);
+      }
+      result.push({ id: node.getAttribute('data-original-art') || node.getAttribute('data-art2') || '', colors: colors.size, opaque, width: image.naturalWidth, height: image.naturalHeight });
+    }
+    await new Promise<void>(resolve => requestAnimationFrame(() => requestAnimationFrame(() => resolve())));
+    return result;
+  });
+  expect(paints.length, 'At least one visible art paint must be inspected').toBeGreaterThan(0);
+  for (const paint of paints) {
+    expect(paint.opaque, `${paint.id} decoded but has no visible pixels`).toBeGreaterThan(20);
+    expect(paint.colors, `${paint.id} is blank or monochrome`).toBeGreaterThanOrEqual(3);
+  }
+  return paints;
+}
