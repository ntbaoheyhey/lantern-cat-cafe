+    if (problem === 'missing-item') state.equipment.mochi!.weapon = 'missing-gear';
+    if (problem === 'wrong-slot') {
+      delete state.equipment.mochi!.weapon;
+      state.equipment.mochi!.outfit = weapon;
+    }
