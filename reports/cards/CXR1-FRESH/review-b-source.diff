+
+for (const id of ['landing', 'class'] as const) it(`${id} frame remains named without HUD or rail`, () => {
+  render(<ScreenFrame activeScreen={id} onSelectScreen={vi.fn()} hudProps={null}>Entry fixture</ScreenFrame>);
