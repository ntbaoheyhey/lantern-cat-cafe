 /** Apply the exact public, deterministic quote. Desire and purchase timing are
  * modeled separately; insufficient funds never create debt or a free benefit. */
 export function buyStudioRecipe(runtime,account,id,now,spend) {
+ const costs=runtime.ECONOMY_LAB.sinks[id];
+ if(!costs)return null;
+ // All quotes consume bound Thread. Reject a known insufficient balance before
+ // scanning the finite collection or constructing an otherwise identical quote.
+ const minimumThread=id==='polish'?Math.min(...costs.starThread):costs.starThread;
+ if(account.stars<minimumThread)return null;
  const inventory=account.studio;
