+  // Pillow perimeter is a bevelled custom polygon, with stuffed front and back panels.
+  const outline = [[-.40, -.33], [-.46, -.18], [-.45, .24], [-.34, .38], [.34, .38], [.45, .24], [.46, -.18], [.40, -.33]];
